# Godot 4 import cache / 编辑器本地缓存（打开工程自动重建，不入库）
.godot/

# Per-computer Godot executable path (one UTF-8 line, no quotes).
godot.local.txt

# 导出产物（部分单文件超过 GitHub 100MB 上限；本地构建即可）
build/

# 冗余源码快照
source code.zip

# 系统 / 编辑器杂项
.DS_Store
*.tmp
*~

# 会话临时目录（不入库）
scratchpad/*
!scratchpad/.gdignore

# Godot-generated QA sidecars; source evidence and already tracked files remain versioned.
# Explicitly include a sidecar if a production or QA provenance manifest requires it.
qa/**/*.import
qa/**/*.uid
!qa/stabilization_dust_filter_20260907/normal_ab/executed_projects/A/tools/polish_performance_probe.gd.uid
!qa/stabilization_dust_filter_20260907/normal_ab/executed_projects/B/tools/polish_performance_probe.gd.uid
!qa/stabilization_dust_filter_20260907/normal_ab/executed_projects/A/tools/zhujiazhuang_rts_test.gd.uid
!qa/stabilization_dust_filter_20260907/normal_ab/executed_projects/B/tools/zhujiazhuang_rts_test.gd.uid

# Standalone localization QA scripts are loaded by path.
/tools/localization_qa.gd.uid
/tools/localization_package_probe.gd.uid
/tools/text_ui_review.gd.uid
/tools/battle_text_ui_review.gd.uid
/tools/text_review_contract.gd.uid

# Rebuildable Python maintenance cache.
__pycache__/
