	"hou_jian": "通臂猿。洪都裁缝，黑瘦轻捷、飞针走线，曾从薛永学枪棒；掌梁山旌旗袍袄，征方腊时在钱塘江风浪中溺亡。",
	"chen_da": "跳涧虎。少华山头领，使出白点钢枪，借粮华阴遇史进，三人共聚少华山。",
	"yang_chun": "白花蛇。少华山头领，使大杆刀，与朱武、陈达结义，后随史进归梁山。",
	"zheng_tianshou": "白面郎君。苏州人，原以打银为生，面貌白净俊俏，自幼习枪棒；与燕顺、王英同为清风山头领，后入梁山。",
	"tao_zongwang": "九尾龟。庄家出身，使铁锹、善掘壕筑寨，梁山专司土工，润州阵亡。",
	"song_qing": "铁扇子。宋江之弟，随兄上山，掌梁山筵宴庆赏，招安后辞官归乡务农。",
	"yue_he": "铁叫子。登州小牢子，能歌善唱、机灵伶俐，传信助救解珍解宝；梁山大聚义后任军中走报机密头领。",
	"mu_chun": "小遮拦。揭阳镇穆弘之弟，与兄称霸一方，随兄上山，征方腊后辞官归乡。",
	"cao_zheng": "操刀鬼。林冲徒弟、屠户出身，献计智取二龙山，掌梁山屠宰，征方腊阵亡。",
	"song_wan": "云里金刚。梁山开山元老，身躯高大，守山寨关隘，润州乱军阵亡。",
	"du_qian": "摸着天。梁山开山元老，身材瘦高，与宋万同守关隘，清溪乱军阵亡。",
	"xue_yong": "病大虫。江湖卖艺使枪棒，落魄遇宋江，大名府内应放火，征方腊阵亡。",
	"li_zhong": "打虎将。卖艺师父、史进开手师，桃花山头领，后随鲁智深武松归梁山。",
	"zhou_tong": "小霸王。桃花山头领，强抢民女被鲁智深痛打，使点钢枪，后归梁山。",
	"du_xing": "鬼脸儿。李家庄主管，貌丑怪、机警善应对，随李应上山。",
	"zou_yuan": "出林龙。登云山草莽，与侄邹润相伴；随孙立等劫登州牢、内应破祝家庄，后为梁山步军将校。",
	"zou_run": "独角龙。邹渊之侄，后脑生肉瘤如角、能以头触树，与叔同上梁山。",
	"zhu_gui": "旱地忽律。梁山泊酒店店主、山寨眼线总管，迎来送往、通报军情。",
	"zhu_fu": "笑面虎。朱贵之弟，开酒店，曾用蒙汗药救李逵并赚李云上山；梁山大聚义后监造供应酒醋。",
	"cai_fu": "铁臂膊。大名府押狱兼刽子手，膀大力沉，受托保全卢俊义、石秀，后归梁山。",
	"cai_qing": "一枝花。蔡福之弟，行刑却鬓边簪花，与兄同护卢俊义，后归梁山。",
	"li_li": "催命判官。揭阳岭黑店主，惯使蒙汗药剪径，与李俊相识，后上梁山。",
	"li_yun": "青眼虎。沂水县都头，眼带青光、刚直善战，受朱富蒙汗药赚上山。",
	"jiao_ting": "没面目。中山府人，祖传三代相扑为生，因到处投人不着而得此号；结识李逵后同上梁山，为步军将校。",
	"shi_yong": "石将军。江湖赌徒、使朴刀，传宋江家书牵线，落草梁山，步军头领。",
	"sun_xin": "小尉迟。孙立之弟，与妻顾大嫂开店，劫牢救解珍解宝，随兄破祝家庄。",
	"gu_dasao": "母大虫。孙新之妻，泼辣彪悍、使双刀，劫登州大牢救表弟，梁山三女将之一。",
	"zhang_qing_cai": "菜园子。十字坡黑店主，孙二娘之夫，与武松结义，后上二龙山归梁山。",
	"sun_erniang": "母夜叉。十字坡黑店女老板，张青之妻，蒙汗药做人肉包，助武松扮行者，三女将之一。",
	"wang_dingliu": "活闪婆。建康府江边卖酒，身轻脚快，随张顺上梁山；大聚义后与李立掌北山酒店，迎宾探事。",
	"yu_baosi": "险道神。身长一丈的青州强人，曾劫夺梁山所买马匹并送往曾头市；后为梁山内应，归山后掌中军帅字旗。",
	"shi_qian": "鼓上蚤。江湖第一飞贼，飞檐走壁、轻功盖世，盗甲赚徐宁、火烧翠云楼，神出鬼没。",
	"duan_jingzhu": "金毛犬。涿州盗马好汉，赤发黄须，盗照夜玉狮子马欲献宋江；入梁山后曾赴北地买马，大聚义后任军中走报机密头领。",
}

