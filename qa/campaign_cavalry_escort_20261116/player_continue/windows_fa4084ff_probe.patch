+func _check_finished_debrief(b) -> void:
+	check(b.hud._end_root.visible,"continued victory opens the real settlement panel")
+	if not failures.is_empty(): return
+	var rows: Array = b.level.campaign_debrief(b.mission)
+	check(rows.size()==3 and rows[0].args[0]=="北路" and rows[1].args[0]=="南路","both original lanes have outcome rows")
+	check(rows[0].args[1]==0 and rows[1].args[1]==0 and rows[2].args[0]==b.level.broken_count,
+		"the completed battle shows both lanes empty and counts actual hook breaks")
+	var localization = root.get_node("Localize")
+	var catalog: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/localization/catalog.json"))
+	var snapshots := {}
+	for language in ["zh_CN","zh_TW","en","ja"]:
+		localization._formatted_sources.clear()
+		localization.set_language(language,false)
+		await process_frame
+		var lines := PackedStringArray()
+		for row in rows:
+			var args: Array = row.args if language == "zh_CN" else row.args.map(func(value): return catalog[value][language] if value is String else value)
+			lines.append((row.source if language == "zh_CN" else catalog[row.source][language]) % args)
+		check(lines.size()==3 and Array(lines).all(func(line): return line in b.hud._end_tally.text),"riders, supply and hooks in "+language)
+		snapshots[language] = lines
+	facts["debrief"] = snapshots
