+## Fixed Level8 record pairing only. No caller bool, Unit metadata, saved script
+## path or live Node chooses eligibility; all five records are independently
+## checked against the installed context before any Unit/tombstone allocation.
+# Reject fixed identity leaf types before old validators compare dictionaries.
+# This adds no coercion/normalization and changes no public validator.
+func _daming_safe_record_identity_types(sections: Dictionary) -> Dictionary:
+	var text_fields: Dictionary={"units":["schema","content_version"],"level":["schema","level_id","content_version","mission_token"],"root":["schema","content_version"],"mission":["schema"],"presentation":["schema"]}
+	for section: String in text_fields:
+		var record: Variant=sections.get(section)
+		if typeof(record)!=TYPE_DICTIONARY:return _bad("LEVEL8_SAFE_RECORD_TYPE",section)
+		for field: String in text_fields[section]:
+			if typeof(record.get(field))!=TYPE_STRING:return _bad("LEVEL8_SAFE_IDENTITY_TEXT_TYPE",section+"/"+field)
+		if section in ["mission","presentation"]:
+			var context: Variant=record.get("context")
+			if typeof(context)!=TYPE_DICTIONARY or context.size()!=4 or not context.has_all(["level_id","content_version","mission_token","presentation_token"]):return _bad("LEVEL8_SAFE_CONTEXT_TYPE",section)
+			for field: String in ["level_id","content_version","mission_token","presentation_token"]:
+				if typeof(context[field])!=TYPE_STRING:return _bad("LEVEL8_SAFE_CONTEXT_TEXT_TYPE",section+"/"+field)
+	return {"ok":true}
