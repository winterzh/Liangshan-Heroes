+		"_pending_item_casts": return {"caster": safe, "slot": 0, "uid": uid, "point": safe.position, "target": null, "serial": serial}
+		"_walk_item_casts": return {"c": safe, "uid": uid, "tgt": null, "point": safe.position, "serial": serial, "t": 0.4, "age": 0.0}
+	return {}
+
