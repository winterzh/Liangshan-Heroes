  "findings": [
    {
      "id": "RAW-STOP-001",
      "severity": "blocking",
      "file": "D:/AI项目/水浒/开发工程/tools/campaign_callback_raw_receiver_v1.py",
      "lines": [
        60,
        61,
        62,
        80
      ],
      "problem": "Entry live/competing-peer-buffer failures are outside the stop latch. A detected old decoded receiver buffer raises WireError without setting stopped or retaining refusal state. Clearing that external buffer then permits the same raw receiver to resume, although exclusive original-stream framing is no longer established.",
      "independent_reproduction": {
        "classification": "constructor-bypassing synthetic memory stream; no socket/Popen/Godot",
        "initial_peer_buffer": "prior consumed bytes",
        "first_receive_error": "No competing decoded receiver on this transport",
        "stopped_after_refusal": false,
        "recv_calls_before_refusal": 0,
        "peer_bytes_preserved": true,
        "refusal_events_retained": 0,
        "after_external_peer_buffer_clear_same_receiver_handles_complete_frame": true
      },
      "minimal_fix": "Latch permanent stop on non-timeout live/peer-buffer gate failures at entry and before recv; preserve both own partial bytes and old peer-buffer bytes with refusal status. Retention failure must leave stopped and buffers intact. Only an actual recv socket.timeout should permit continuation with the original buffer."
    }
  ],
