+# External QA adaptation only. Query the installed, hash-bound native bridge;
+# never infer external process death from Godot's own child-process map.
+const Liveness = preload("res://scripts/run_process_liveness_manager.gd")
+var liveness_observations: Array = []
+
+func observe_pid(target_pid: int, wanted: String) -> bool:
+	var binding: String = JSON.stringify({"fixture":"store_io_v2","nonce":nonce,"mode":mode,"pid":target_pid})
+	var opened: Dictionary = Liveness.open_scope(binding)
+	if not opened.ok: return false
+	var result: Dictionary = Liveness.query_dead(int(opened.scope_id),target_pid,binding.sha256_text(),"inspect")
+	var closed: Dictionary = Liveness.close_scope(int(opened.scope_id))
+	liveness_observations.append({"expected_state":wanted,"target_pid":target_pid,"result":result.duplicate(true),"scope_closed":closed.ok})
+	if not closed.ok: return false
+	if wanted == "dead":
+		return result.ok and result.get("code") == "PROCESS_CONFIRMED_DEAD" \
+			and result.get("pid") == target_pid and result.get("observation",{}).get("state") == "dead"
+	return not result.ok and result.get("code") == "WRITER_ALIVE" \
+		and result.get("liveness_detail",{}).get("state") == "alive" \
+		and result.get("liveness_detail",{}).get("target_pid") == target_pid
+
