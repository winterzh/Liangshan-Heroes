+func _show_battle_loading(campaign_level_id: String) -> void:
+	# Cap rendering so the loading view does not compete with file verification.
+	# On Windows, leave room for frame-pacing jitter around the 60 Hz budget.
+	var loading_max_fps := 72 if OS.get_name() == "Windows" else 60
+	_entry_previous_max_fps = Engine.max_fps
+	if Engine.max_fps == 0 or Engine.max_fps > loading_max_fps:
+		Engine.max_fps = loading_max_fps
+	var focused := get_viewport().gui_get_focus_owner()
+	if focused != null:
+		focused.release_focus()
+	_entry_overlay = ColorRect.new()
+	_entry_overlay.name = "BattleLoading"
+	_entry_overlay.color = Color(UITheme.INK, 0.97)
+	_entry_overlay.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	add_child(_entry_overlay)
+	var center := CenterContainer.new()
+	center.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
+	_entry_overlay.add_child(center)
+	var column := VBoxContainer.new()
+	column.add_theme_constant_override("separation", 20)
+	center.add_child(column)
+	var label := Label.new()
+	var destination := _battle_loading_destination(campaign_level_id)
+	if destination.is_empty():
+		Localize.bind_text(label, "正在读取战斗，请稍候…")
+	else:
+		Localize.bind_format(label, "正在准备战斗 · %s", destination)
+	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
+	label.add_theme_font_size_override("font_size", 24)
+	column.add_child(label)
+	var progress := ProgressBar.new()
+	progress.custom_minimum_size = Vector2(360, 12)
+	progress.show_percentage = false
+	progress.indeterminate = true
+	column.add_child(progress)
+
+
+func _battle_loading_destination(campaign_level_id: String) -> String:
+	if Campaign.scenario:
+		return "自定义关卡"
+	if Campaign.custom_defense:
+		return "自定义据守"
+	if Campaign.arena:
+		return "竞技场"
+	if Campaign.skirmish_ai:
+		return "1v1 对战"
+	if Campaign.skirmish:
+		return "驻守战"
+	var index := Campaign.index_for_id(campaign_level_id)
+	return String(Campaign.LEVELS[index]["title"]) if index >= 0 else ""
+
+
+func _input(_event: InputEvent) -> void:
+	if _entry_overlay != null:
+		get_viewport().set_input_as_handled()
+
+
+func _begin_battle_scan(prewarm := false) -> void:
+	var provider: Script = load("res://scripts/run_content_identity.gd")
+	if provider == null:
+		return
+	_entry_scan = provider.new()
+	if _entry_scan.begin_runtime_identity_scan(prewarm) != OK:
+		_entry_scan = null
+
+
+func _request_battle_surfaces(campaign_level_id: String) -> void:
+	var surface_level := "level5" if Campaign.skirmish or Campaign.custom_defense else campaign_level_id
+	if surface_level.is_empty():
+		return
+	var baseline := "LIANGSHAN_VISUAL_BASELINE" if surface_level == "level5" else "CAMPAIGN_ENV_BASELINE"
+	if OS.get_environment(baseline) == "1":
+		return
+	for path in CampaignEnvironmentArt.surface_texture_paths(surface_level):
+		if ResourceLoader.load_threaded_request(path, "Texture2D") == OK:
+			_entry_surface_requests.append(path)
+
+
+func _finish_battle_launch() -> void:
+	if _entry_scan == null:
+		_begin_battle_scan()
+	var identity: Dictionary = {}
+	if _entry_scan != null:
+		while _entry_scan.runtime_identity_scan_pending():
+			await get_tree().process_frame
+			if AppLifecycle.quit_started(): return
+		identity = _entry_scan.finish_runtime_identity_scan()
+		_entry_scan = null
+		if identity.get("code") == "PREWARM_EXECUTABLE_CHANGED" and not AppLifecycle.quit_started():
+			_finish_battle_launch.call_deferred()
+			return
+	if AppLifecycle.quit_started():
+		return
+	var ground_textures: Array[Texture2D] = []
+	for path in _entry_surface_requests:
+		var texture := (await _wait_for_battle_resource(path)) as Texture2D
+		if AppLifecycle.quit_started():
+			return
+		if texture != null:
+			ground_textures.append(texture)
+	_entry_surface_requests.clear()
+	for path in _entry_merchant_requests:
+		var frames := (await _wait_for_battle_resource(path)) as SpriteFrames
+		if AppLifecycle.quit_started():
+			return
+		Art.cache_prepared_native_body(path, frames)
+	_entry_merchant_requests.clear()
+	# process_frame runs before this frame's drawing. Let the loading view paint
+	# before the synchronous scene installation, even when the worker ends early.
+	await RenderingServer.frame_post_draw
+	if AppLifecycle.quit_started():
+		return
+	_install_battle.call_deferred(identity, ground_textures)
+
+
+func _wait_for_battle_resource(path: String) -> Resource:
+	var status := ResourceLoader.load_threaded_get_status(path)
+	while status == ResourceLoader.THREAD_LOAD_IN_PROGRESS:
+		await get_tree().process_frame
+		if AppLifecycle.quit_started():
+			return null
+		status = ResourceLoader.load_threaded_get_status(path)
+	return ResourceLoader.load_threaded_get(path) if status == ResourceLoader.THREAD_LOAD_LOADED else null
+
+
+func _install_battle(identity: Dictionary, ground_textures: Array[Texture2D]) -> void:
+	if AppLifecycle.quit_started():
+		return
+	var scene: PackedScene = load("res://scenes/main.tscn")
+	if scene != null:
+		var battle := scene.instantiate()
+		battle.prepare_new_gameplay_identity(identity)
+		if not ground_textures.is_empty():
+			# Keep Godot's cached textures alive through the battle's _ready.
+			battle.ready.connect(func(): ground_textures.clear(), CONNECT_ONE_SHOT)
+		if get_tree().change_scene_to_node(battle) == OK:
+			return
+		battle.free()
+	_entry_overlay.queue_free()
+	_entry_overlay = null
+	_restore_battle_loading_frame_limit()
+	push_error("Could not enter battle")
+
+
+func _restore_battle_loading_frame_limit() -> void:
+	if _entry_previous_max_fps >= 0:
+		Engine.max_fps = _entry_previous_max_fps
+		_entry_previous_max_fps = -1
+
+
+func _cancel_battle_scan() -> void:
+	if _entry_scan != null:
+		_entry_scan.cancel_runtime_identity_scan()
+		_entry_scan = null
+
+
+func cancel_battle_prewarm() -> void:
+	if _entry_overlay == null:
+		_cancel_battle_scan()
+
+
+func _exit_tree() -> void:
+	_restore_battle_loading_frame_limit()
+	_cancel_battle_scan()
