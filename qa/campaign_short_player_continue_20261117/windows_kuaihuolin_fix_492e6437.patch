+static func _check_compiled_debrief(probe, chapter: String) -> void:
+	var b = probe.current_scene
+	probe.check(b.hud._end_root.visible,"continued victory opens the actual debrief")
+	var localization = probe.root.get_node("Localize")
+	var catalog: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://assets/localization/catalog.json"))
+	var expected := []
+	if chapter == "level1":
+		expected = [["夺纲 · %s",["转为强夺"]],["运出车货 · %d/7 车 · %d/11 担",[7,11]],
+			["西冈口 · %d/8 人到达",[b.level._companions_at_exit(b,b.level._living_companions())]]]
+	else:
+		expected = [["酒望 · 饮酒 %d/4 处",[4]],["反击命中 %d 次 · %s",[b.level.counter_hits,"玉环步接鸳鸯脚命中"]],
+			["酒店 · %s",["已交还施恩"]]]
+	var snapshots := {}
+	for language in ["zh_CN","zh_TW","en","ja"]:
+		localization._formatted_sources.clear()
+		localization.set_language(language,false)
+		await probe.process_frame
+		var lines := PackedStringArray()
+		for row in expected:
+			var args: Array = row[1] if language == "zh_CN" else row[1].map(func(value): return catalog[value][language] if value is String else value)
+			lines.append((row[0] if language == "zh_CN" else catalog[row[0]][language]) % args)
+		probe.check(lines.size()==3 and Array(lines).all(func(line): return line in b.hud._end_tally.text),"continued battle outcomes in "+language)
+		snapshots[language] = lines
+	probe.facts["debrief"] = snapshots
