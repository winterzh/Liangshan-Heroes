+func _native_stalls(b) -> Array:
+	var records := []
+	var key := "campaign_environment_text_surface_id"
+	for node in b.map.sample_scenery.get_children():
+		if not node.has_meta(key): continue
+		records.append([String(node.get_meta(key)), String(node.get_meta("campaign_environment_route")), String(node.native_texture.resource_path),
+			node.normalized_text_rect, [node.native_draw_offset.x,node.native_draw_offset.y]])
+	return records
+
+func _check_stall_metadata(b) -> void:
+	var records := _native_stalls(b)
+	var surfaces := records.map(func(record): return record[0])
+	surfaces.sort()
+	check(surfaces == ["level7_stall_dice_sign","level7_stall_goods_sign","level7_stall_inn_a_sign","level7_stall_inn_b_sign",
+		"level7_stall_money_sign","level7_stall_wine_sign"],"all six authored stall sign IDs are active")
+	var state: Script = load("res://scripts/run_scenery_state.gd")
+	var version := String(flow._startup_identity.get("content_version",""))
+	var adapter = state.new(version,CONTEXT)
+	var plain = state.new(version,{})
+	var key := "campaign_environment_text_surface_id"
+	check(adapter._meta_allowed(key,"story_stall") and not adapter._meta_allowed(key,"sprite") 		and not plain._meta_allowed(key,"story_stall"),"only Kuaihuolin market stalls can save a sign ID")
+	check(not adapter._meta_allowed("unknown_stall_metadata","story_stall"),"unrelated stall metadata is still rejected")
